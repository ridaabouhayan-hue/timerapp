{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tijdvak",
  "version": "0.1.0",
  "identifier": "nl.abouhayan.tijdvak",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tijdvak",
        "width": 560,
        "height": 380,
        "minWidth": 240,
        "minHeight": 140,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Dutch", "English"] },
      "wix": { "language": "nl-NL" }
    }
  }
}
